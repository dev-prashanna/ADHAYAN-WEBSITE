# ---------------------------------------------------------------------------
# ADHAYAN website — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Flask session/CSRF signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to true in production (requires HTTPS). false for local development.
SESSION_COOKIE_SECURE=false

# true enables Flask debug mode. Never enable in production.
FLASK_DEBUG=false

# ---------------------------------------------------------------------------
# Persistent data (SQLite database + uploaded images)
# On Render, mount a persistent disk and point these at it (see render.yaml).
# Locally the defaults (./instance and ./instance/uploads) are fine.
# ---------------------------------------------------------------------------
# DATA_DIR=/var/data
# UPLOAD_FOLDER=/var/data/uploads
# DATABASE_URL=sqlite:////var/data/adhayan.db

# ---------------------------------------------------------------------------
# Public site URL — used for sitemap, canonical URLs and Open Graph tags.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:5000

# Contact form recipient. Messages are always stored in the admin inbox;
# this enables optional SMTP delivery as well.
# CONTACT_RECIPIENT=hello@adhayan.org
# CONTACT_EMAIL=hello@adhayan.org

# ---------------------------------------------------------------------------
# Optional SMTP delivery for the contact form.
# Leave MAIL_SERVER empty to keep messages admin-inbox-only (fine to start).
# ---------------------------------------------------------------------------
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=website@adhayan.org

# ---------------------------------------------------------------------------
# Administrator bootstrap for `flask create-admin` (scripts/init_db.py).
# Used only when the account does not exist yet.
# ---------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Login rate limiting (failed attempts per window, per client IP).
# ---------------------------------------------------------------------------
# LOGIN_RATE_LIMIT=8
# LOGIN_RATE_WINDOW=300
