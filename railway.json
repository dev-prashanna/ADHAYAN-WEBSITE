{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && python -m flask --app run db upgrade && python scripts/init_db.py && python scripts/import_content.py"
  },
  "deploy": {
    "startCommand": "gunicorn run:app --bind 0.0.0.0:$PORT --workers 1 --timeout 60",
    "healthcheckPath": "/robots.txt",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "envVars": {
      "PYTHON_VERSION": "3.12.8",
      "DATA_DIR": "/data",
      "UPLOAD_FOLDER": "/data/uploads",
      "SESSION_COOKIE_SECURE": "true",
      "FLASK_DEBUG": "false"
    }
  }
}
