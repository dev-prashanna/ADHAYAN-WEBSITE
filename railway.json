{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "healthcheckPath": "/robots.txt",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "envVars": {
      "PYTHON_VERSION": "3.12.8",
      "DATA_DIR": "/data",
      "UPLOAD_FOLDER": "/data/uploads",
      "SESSION_COOKIE_SECURE": "true",
      "FLASK_DEBUG": "false"
    }
  }
}
